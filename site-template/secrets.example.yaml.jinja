# Template for secrets.sops.yaml. `make secrets` copies it, encrypts it for
# the age recipients in .sops.yaml and opens it in $EDITOR.
# Every top-level key becomes an environment variable of each make target
# (sops exec-env). Flat keys only. Non-secret settings (NETBOX_URL,
# PROXMOX_HOST, PROXMOX_VALIDATE_CERTS) are in the Makefile.
---

# --- Proxmox API (make plan / vms) ------------------------------------------------
# Token of ansible@pve; roles and pveum commands: the vms role's README in
# proxmox-netbox-ansible (ansible_collections/packetflow/proxmox/roles/vms).
PROXMOX_USER: ansible@pve
PROXMOX_TOKEN_ID: {{ site_slug }}
PROXMOX_TOKEN_SECRET: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Other clusters (vms_clusters entries with api_env): one token per cluster,
# with rights only on this site's pool there, e.g.
#   PROXMOX_SHARED_USER: {{ site_slug }}@pve
#   PROXMOX_SHARED_TOKEN_ID: {{ site_slug }}
#   PROXMOX_SHARED_TOKEN_SECRET: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Zabbix API (make zabbix-status) ------------------------------------------------
# An API token (Users -> API tokens) of a user allowed to enable and disable hosts.
#   ZABBIX_URL: "https://zabbix.example"
#   ZABBIX_VALIDATE_CERTS: "true"
#   ZABBIX_API_TOKEN: "xxxxxxxx"

# --- NetBox (inventory, make plan / vms, make seed) ---------------------------------
# NetBox >= 4.5: the full v2 value nbt_<key>.<token>. make seed --apply needs
# write permission; everything else only reads.
NETBOX_TOKEN: "nbt_xxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
