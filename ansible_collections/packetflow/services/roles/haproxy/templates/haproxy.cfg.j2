# {{ ansible_managed }}
# Services: haproxy_services in the site's host vars. Host -> backend: hosts.map.
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # Mozilla "intermediate" TLS settings.
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-default-server-options ssl-min-ver TLSv1.2
{% for line in haproxy_global_extra %}
    {{ line }}
{% endfor %}

defaults
    log global
    mode http
    option httplog
    option dontlognull
    option forwardfor
    timeout connect {{ haproxy_timeout_connect }}
    timeout client {{ haproxy_timeout_client }}
    timeout server {{ haproxy_timeout_server }}
    timeout tunnel {{ haproxy_timeout_tunnel }}
    timeout http-request 10s
{% for line in haproxy_defaults_extra %}
    {{ line }}
{% endfor %}

frontend http
    bind {{ haproxy_bind }}:80
    http-request redirect scheme https code 301

frontend https
    bind {{ haproxy_bind }}:443 ssl crt-list /etc/haproxy/crt-list.txt alpn h2,http/1.1
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Host %[req.hdr(host)]
{% if haproxy_hsts %}
    http-response set-header Strict-Transport-Security "max-age=31536000"
{% endif %}
    use_backend %[req.hdr(host),lower,field(1,:),map_str(/etc/haproxy/hosts.map,unknown_host)]

backend unknown_host
    http-request return status 404 content-type text/plain string "No service for this host name.\n"
{% if haproxy_stats_bind %}

frontend stats
    bind {{ haproxy_stats_bind }}
    stats enable
    stats uri /
    stats refresh 10s
{% endif %}
{% for svc in haproxy_services %}

# {{ svc.hosts | join(', ') }}
backend {{ svc.name }}
{% if svc.check | default(true) and svc.check_path | default('') %}
    option httpchk
    http-check send meth GET uri {{ svc.check_path }} hdr Host {{ svc.hosts | first }}
    http-check expect status 200-399
{% endif %}
{% for line in svc.options | default([]) %}
    {{ line }}
{% endfor %}
{% for server in svc.servers %}
    server {{ svc.name }}{{ loop.index }} {{ server }}
{{- ' check' if svc.check | default(true) else '' }}
{%- if svc.ssl | default(false) %} ssl {{ 'verify required ca-file @system-ca' if svc.verify | default(false) else 'verify none' }}{% endif %}
{{- ' ' ~ svc.server_options if svc.server_options | default('') else '' }}
{% endfor %}
{% endfor %}
